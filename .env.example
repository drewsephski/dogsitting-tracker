# Database — Neon (recommended)
# Link the repo (`npx neon link`), then run `pnpm neon:env` to refresh `.env.local`.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
NEON_BRANCH="production"
# Set after `pnpm neon:apply` when `hello` is declared in neon.ts
NEON_FUNCTION_HELLO_BASE_URL="https://your-branch-hello.compute.region.aws.neon.tech/"

# Neon Auth (Managed Better Auth) — run `pnpm neon:env` after `pnpm neon:apply` with auth enabled in neon.ts
NEON_AUTH_BASE_URL="https://your-branch.neonauth.region.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET="generate-with-openssl-rand-base64-32-min-32-chars"

# AI chat (OpenRouter)
OPENROUTER_API_KEY="your-openrouter-api-key"
# OPENROUTER_MODEL="z-ai/glm-5.3-flash"

# Local Docker Postgres (optional; use instead of Neon for offline dev)
# DATABASE_URL="postgresql://dogsit:securepassword@localhost:5432/dogsitting"
# DATABASE_HOST="localhost"
# DATABASE_USER="dogsit"
# DATABASE_PASSWORD="securepassword"
# DATABASE_NAME="dogsitting"
# DATABASE_PORT="5432"
