{
  "name": "tablecn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf --glob **/node_modules **/dist **/.next pnpm-lock.yaml **/.tsbuildinfo",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "ollie": "pnpm install && pnpm run db:start && pnpm run db:setup",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "shadcn": "pnpm dlx shadcn@latest",
    "build:registry": "shadcn build",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:generate": "dotenv -e .env -e .env.local -- drizzle-kit generate",
    "db:introspect": "dotenv -e .env -e .env.local -- drizzle-kit introspect",
    "db:push": "dotenv -e .env -e .env.local -- drizzle-kit push",
    "db:migrate": "dotenv -e .env -e .env.local -- tsx src/db/migrate.ts",
    "db:drop-migration": "drizzle-kit drop",
    "db:seed": "dotenv -e .env -e .env.local -- tsx src/db/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:reset": "pnpm db:stop && rimraf docker-data && pnpm db:start && sleep 10 && pnpm db:setup",
    "db:studio": "dotenv -e .env -e .env.local -- drizzle-kit studio",
    "neon:plan": "neon config plan",
    "neon:apply": "neon config apply",
    "neon:env": "neon env pull",
    "neon:test:hello": "dotenv -e .env.local -- sh -c 'curl -sfL \"$NEON_FUNCTION_HELLO_BASE_URL\"'"
  },
  "dependencies": {
